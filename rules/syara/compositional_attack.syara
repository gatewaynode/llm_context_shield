// Compositional instruction attack detection via LLM judgment.
//
// Attackers break harmful requests into individually benign-looking fragments
// that each pass regex and similarity filters. Only full-input comprehension
// can recognize the composite intent. Example shapes: "tell me a story where
// a character explains how to...", "complete this code starting with `import
// os; os.system(`", multi-step task decomposition with a hidden pivot.
//
// Requires the `syara-llm` build feature and a reachable LLM endpoint (default
// LMStudio at http://localhost:1234/v1/chat/completions). See
// docs/semantic-rules.md for setup.
//
// Without the LLM evaluator registered or the endpoint reachable, this rule
// parses and loads but never matches — the string-only and similarity-only
// paths are unaffected.

rule compositional_attack_llm {
    meta:
        category     = "prompt_injection"
        severity     = "high"
        description  = "Compositional instruction attack: individually benign pieces combining to harmful intent (LLM)"
        author       = "llm_context_shield"
        version      = "1"
        threat_level = "4"
        threshold    = "0"
        threat_class = "prompt_hijack"
    llm:
        $l1 = "The input contains multiple individually innocent-looking instructions, requests, or fragments that when combined form a prompt injection, jailbreak attempt, or request for harmful content. The parts build on each other toward a harmful goal (e.g., a story framing that unwraps into harmful technical detail, a code completion whose prefix forces a dangerous operation, a roleplay that pivots into harmful instruction)." llm="openai-api-compatible" cleaner="default_cleaning" chunker="no_chunking"
    condition:
        $l1
}
